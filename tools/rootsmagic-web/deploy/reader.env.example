ROOTSMAGIC_ALLOWED_HOSTS=reader.example.org,lan-reader.example.org
ROOTSMAGIC_DB="/srv/rootsmagic-reader/trees/family-tree.rmtree"
ROOTSMAGIC_TREE_DIR=/srv/rootsmagic-reader/trees
# ROOTSMAGIC_START_PERSON=123
ROOTSMAGIC_DEFAULT_TREE_SLUG=family-tree
ROOTSMAGIC_ACCOUNTS_DB=/srv/rootsmagic-reader/state/accounts.sqlite3
# Optional. Defaults to comments.sqlite3 beside the hosted account database.
# ROOTSMAGIC_COMMENTS_DB=/srv/rootsmagic-reader/state/comments.sqlite3
# ROOTSMAGIC_SETTINGS_FILE=/srv/rootsmagic-reader/state/settings.json
ROOTSMAGIC_BACKUP_STATUS_FILE=/srv/rootsmagic-reader/backup-status/latest.json
ROOTSMAGIC_PUBLIC_ORIGIN=https://reader.example.org
ROOTSMAGIC_ADDITIONAL_ORIGINS=https://lan-reader.example.org
# Apply account limits if the request carries only the shared proxy's address.
# ROOTSMAGIC_SHARED_PROXY_ADDRESSES=192.0.2.10
ROOTSMAGIC_FONT_REGULAR=/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf
ROOTSMAGIC_FONT_BOLD=/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf
ROOTSMAGIC_FONT_TITLE=/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf
# ROOTSMAGIC_MEDIA_MAP='{"/Users/example/Projects/FamilyTrees":"/mnt/archive/RootsMagicReader/Media/family-trees","/Volumes/home/FamilyArchive/Books":"/mnt/archive/Books"}'
